---
user: debian
uid: 1000
group: docker
gid: 998
ssh_port: 22
domain: example.com
dynamic_ip: false
data_folder: /mnt/storage
tz: Europe/Berlin
notifications_email: example@mail.com
use_crowdsec: true

# Core
cloudflare:
  tag_ddns: latest
  tag_companion: latest
  api_email:
  api_key:
  api_token:
  domain_zone_id:
crowdsec:
  tag: latest-debian
  folder: /opt/crowdsec
  subdomain: crowdsec
  console_enrollment_key: console_enrollment_key
  firewall_bouncer_key: firewall_bouncer_key
  traefik_bouncer_key: traefik_bouncer_key
  whitelist_ip_range: x.x.0.0/16
traefik:
  tag: 3.7.8
  tag_bouncer: v1.6.0
  folder: /opt/traefik
  api_url: "traefik.{{ domain }}"
  origin_certificate:
  origin_certificate_private_key:
portainer:
  tag: latest
  folder: /opt/portainer
  subdomain: portainer
authelia:
  tag: latest
  folder: /opt/authelia
  subdomain: login
  username: demo
  password: demo
  displayname: Demo
  email: example@mail.com
  jwt_secret: a_very_important_secret
  session_name: demo
  unsecure_session_secret: demo
  notification_email_to: "{{ notifications_email }}"
  notification_email_from: "authelia@{{ domain }}"
  notification_email_server: postfix
  notification_email_server_port: 587
  notification_email_server_user:
  notification_email_server_password:
  redis:
    hostname: authelia-redis
    folder: /opt/authelia-redis
  storage_encryption_key: a_string_at_least_64_characters_long
homer:
  tag: latest
  tag_companion: latest
  folder: /opt/homer
  title: SEEDbox Dashboard
  subtitle: "{{ domain }}"
  services:
    - name: Download
      icon: fas fa-cloud-download-alt
    - name: PVR
      icon: fas fa-tv
    - name: Media
      icon: fas fa-compact-disc
    - name: Tools
      icon: fas fa-tools
    - name: Monitoring
      icon: far fa-eye
    - name: Management
      icon: fas fa-user-shield
watchtower:
  tag: latest
  monitor_only: false
  notification_email_to: "{{ notifications_email }}"
  notification_email_from: "watchtower@{{ domain }}"
  notification_email_server: postfix
  notification_email_server_port: 587
  notification_email_server_user:
  notification_email_server_password:
  notification_email_delay: 2
postfix:
  tag: latest
  hostname: postfix

# Download
qbittorrent:
  tag: 5.2.3
  folder: /opt/qbittorrent
  subdomain: qbittorrent
  web_user: admin_qbit
  web_password: admin_qbit_password
  web_password_salt: admin_qbit_password_salt
  bittorrent_port: 6881
rutorrent:
  tag: latest
  folder: /opt/rutorrent
  subdomain: rutorrent
  bittorrent_port: 50000
  dht_port: 58000
nzbget:
  tag: latest
  folder: /opt/nzbget
  subdomain: nzbget
  restricted_username: demo
  restricted_password: demo
sabnzbd:
  tag: latest
  folder: /opt/sabnzbd
  subdomain: sabnzbd
flood:
  tag: latest
  folder: /opt/flood
  subdomain: flood
qui:
  tag: latest
  folder: /opt/qui
  subdomain: qui

# PVR
prowlarr:
  tag: latest
  folder: /opt/prowlarr
  subdomain: prowlarr
sonarr:
  tag: latest
  folder: /opt/sonarr
  subdomain: sonarr
radarr:
  tag: latest
  folder: /opt/radarr
  subdomain: radarr
lidarr:
  tag: latest
  folder: /opt/lidarr
  subdomain: lidarr
readarr:
  tag: nightly
  folder: /opt/readarr
  subdomain: readarr
bazarr:
  tag: latest
  folder: /opt/bazarr
  subdomain: bazarr

# Media
seerr:
  tag: latest
  folder: /opt/seerr
  subdomain: seerr
jellyfin:
  tag: latest
  folder: /opt/jellyfin
  subdomain: jellyfin
navidrome:
  tag: latest
  folder: /opt/navidrome
  subdomain: navidrome
kavita:
  tag: latest
  folder: /opt/kavita
  subdomain: kavita
yamtrack:
  tag: latest
  folder: /opt/yamtrack
  subdomain: yamtrack
  secret:
  tmdb_api:
  trakt_api:
  mal_api:
  igdb_id:
  igdb_secret:
  simkl_id:
  simkl_secret:

# Tools
filebrowser:
  tag: latest
  folder: /opt/filebrowser
  subdomain: filebrowser
syncthing:
  tag: latest
  folder: /opt/syncthing
  subdomain: syncthing
archivebox:
  tag: latest
  folder: /opt/archivebox
  subdomain: archivebox
whoami:
  tag: latest
  subdomain: whoami

# Monitoring
netdata:
  tag: latest
  folder: /opt/netdata
  subdomain: netdata
speedtesttracker:
  tag: latest
  folder: /opt/speedtesttracker
  subdomain: speedtesttracker
librespeed:
  tag: latest
  folder: /opt/librespeed
  subdomain: librespeed
scrutiny:
  tag: latest-omnibus
  folder: /opt/scrutiny
  subdomain: scrutiny

# Extras
tinymotd:
  folder: /opt/tinymotd
