global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: ERROR

api:
  dashboard: true

pilot:
  dashboard: false

entryPoints:
  web:
    address: :80
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: :443
    http:
      tls: true

providers:
  docker:
    network: web
    exposedByDefault: false
  file:
    directory: /etc/traefik/dynamic/
    watch: true
